# Environment Variables for AI Career Counselor

# Groq API Key for primary AI Chat functionality (using Llama 3.3 70B)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key for RAG Chat functionality (alternative AI provider)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Rate limiting configuration (defaults provided)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_HOURS=1

# Optional: Chat configuration
MAX_MESSAGE_LENGTH=500
MAX_CONVERSATION_HISTORY=10