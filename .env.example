# Environment Variables for AI Career Counselor

# Gemini API Key for AI Chat functionality
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_herem

# OpenRouter API Key for RAG chat (AI Career Counselor with vector search)
# Get your key from: https://openrouter.ai/keys (requires account and credits)
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional: Rate limiting configuration (defaults provided)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_HOURS=1

# Optional: Chat configuration
MAX_MESSAGE_LENGTH=500
MAX_CONVERSATION_HISTORY=20